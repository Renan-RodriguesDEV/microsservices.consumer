# ============================================================================
# Example Environment Variables for Consumer Application
# Copy this file to .env and fill with your actual values
# ============================================================================

# ============================================================================
# Spring Boot Profile
# ============================================================================
# development, testing, production
SPRING_PROFILES_ACTIVE=development

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/microservice_consumer
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Hibernate configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
# Local RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# OR CloudAMQP (uncomment to use cloud instead of local)
# SPRING_RABBITMQ_ADDRESS=amqps://user:password@host/vhost
# SPRING_RABBITMQ_ADDRESSES=amqps://user:password@host1:5671,amqps://user:password@host2:5671

# ============================================================================
# JWT Security Configuration
# ============================================================================
# ⚠️ IMPORTANT: Change this to a strong random key in production!
# Generate: openssl rand -base64 32
JWT_SECRET=sua-chave-super-secreta-aqui-mudar-em-producao-urgente

# JWT expiration time (milliseconds)
# Default: 24 hours = 86400000
AUTH_JWT_EXPIRATION=86400000

# ============================================================================
# Server Configuration
# ============================================================================
SERVER_PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/

# ============================================================================
# Logging Configuration
# ============================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MICOSERVICE_CONSUMER=DEBUG
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ============================================================================
# Application Information
# ============================================================================
SPRING_APPLICATION_NAME=consumer
SPRING_APPLICATION_VERSION=1.0.0

# ============================================================================
# Docker Compose Specific (if using docker-compose)
# ============================================================================
# Database (internal network)
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/microservice_consumer

# RabbitMQ (internal network)
# SPRING_RABBITMQ_HOST=rabbitmq
# SPRING_RABBITMQ_PORT=5672
